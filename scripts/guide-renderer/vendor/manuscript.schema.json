{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:second-look:consumer-guide-manuscript:1.0",
  "title": "Consumer guide manuscript",
  "type": "object",
  "required": [
    "schemaVersion",
    "productId",
    "slug",
    "title",
    "audience",
    "scope",
    "edition",
    "notice",
    "decisiveLimits",
    "release",
    "contributors",
    "sources",
    "chapters",
    "previewChapterIds",
    "summary",
    "correctionRoute"
  ],
  "properties": {
    "schemaVersion": {
      "const": "consumer-guide-manuscript-1.0"
    },
    "productId": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "edition": {
      "type": "object",
      "required": [
        "id",
        "version",
        "updated",
        "evidenceCutoff"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "updated": {
          "type": "string"
        },
        "evidenceCutoff": {
          "type": "string"
        }
      }
    },
    "notice": {
      "type": "string",
      "minLength": 1
    },
    "decisiveLimits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "release": {
      "type": "object",
      "required": [
        "status",
        "humanEditorial",
        "qualifiedIndependent",
        "legal",
        "accessibility",
        "readerTest",
        "commercial",
        "public"
      ],
      "properties": {
        "status": {
          "const": "draft"
        }
      }
    },
    "contributors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "status"
        ],
        "properties": {
          "orcid": {
            "type": "string",
            "description": "Owner-supplied identifier or canonical URL; rendered only through OrcidCredit with green mark, visible identifier and canonical link."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "title",
          "locator",
          "role"
        ]
      }
    },
    "claimLedger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "sourceIds",
          "sourceLocator",
          "reviewStatus",
          "role"
        ]
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "blocks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        }
      }
    },
    "previewChapterIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "title",
        "blocks"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "correctionRoute": {
      "type": "string"
    },
    "synthetic": {
      "type": "boolean"
    },
    "provenance": {
      "type": "object"
    },
    "policyRoute": {
      "type": "string",
      "format": "uri"
    }
  },
  "$defs": {
    "block": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "paragraph",
            "heading",
            "kicker",
            "callout",
            "notice",
            "source",
            "toc",
            "table",
            "figure",
            "faq",
            "worksheet",
            "bibliography",
            "contributors",
            "entry"
          ]
        },
        "text": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "alt": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "asset": {
          "const": "trace-diagram"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    }
  }
}
