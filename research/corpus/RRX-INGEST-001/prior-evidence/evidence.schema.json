{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-look.invalid/schemas/evidence-1.0.json",
  "title": "Second Look canonical evidence graph v1.0",
  "description": "Production-capable structural schema. Release additionally requires foreign-key, exact-version approval, source audit and server serialization invariants. Synthetic examples excluded from real corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic",
    "topics",
    "searches",
    "screening",
    "papers",
    "studies",
    "results",
    "claims",
    "reviews",
    "context",
    "pages",
    "coverage",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "synthetic": {
      "type": "boolean"
    },
    "topics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/topic"
      }
    },
    "searches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search"
      }
    },
    "screening": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screening"
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    },
    "studies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/study"
      }
    },
    "results": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/result"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      }
    },
    "context": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/context"
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "manifest": {
      "$ref": "#/$defs/manifest"
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paper_id": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "type": "string"
        },
        "file": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf_page": {
          "type": [
            "number",
            "null"
          ]
        },
        "printed_page": {
          "type": [
            "string",
            "null"
          ]
        },
        "section": {
          "type": "string"
        },
        "table_figure": {
          "type": [
            "string",
            "null"
          ]
        },
        "paragraph": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "enum": [
            "full_text",
            "abstract",
            "registry",
            "metadata",
            "official_context"
          ]
        },
        "missingness": {
          "enum": [
            null,
            "not_reported",
            "not_extracted",
            "not_accessible",
            "not_applicable",
            "not_checked",
            "not_identifiable"
          ]
        }
      },
      "required": [
        "paper_id",
        "source_url",
        "file",
        "pdf_page",
        "printed_page",
        "section",
        "table_figure",
        "paragraph",
        "basis",
        "missingness"
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null",
            "array",
            "object"
          ]
        },
        "missing_reason": {
          "enum": [
            null,
            "not_reported",
            "not_extracted",
            "not_accessible",
            "not_applicable",
            "not_checked",
            "not_identifiable"
          ]
        },
        "locators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/locator"
          }
        }
      },
      "required": [
        "value",
        "missing_reason",
        "locators"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "then": {
            "properties": {
              "missing_reason": {
                "enum": [
                  "not_reported",
                  "not_extracted",
                  "not_accessible",
                  "not_applicable",
                  "not_checked",
                  "not_identifiable"
                ]
              }
            }
          }
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "superseded"
          ]
        },
        "content_version": {
          "type": "string"
        },
        "content_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewer_qualifications": {
          "type": [
            "string",
            "null"
          ]
        },
        "conflicts": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "enum": [
            "editorial",
            "clinical_safety",
            "paid_health_product"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "content_version",
        "content_sha256",
        "reviewer_id",
        "reviewer_qualifications",
        "conflicts",
        "decision_at",
        "scope",
        "notes"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              }
            }
          },
          "then": {
            "properties": {
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "reviewer_id": {
                "type": "string",
                "minLength": 1
              },
              "decision_at": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "approved"
              },
              "scope": {
                "enum": [
                  "clinical_safety",
                  "paid_health_product"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "reviewer_qualifications": {
                "type": "string",
                "minLength": 1
              },
              "conflicts": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "topic": {
      "type": "object",
