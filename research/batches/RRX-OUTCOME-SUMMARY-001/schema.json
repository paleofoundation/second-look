{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "remaprx-outcome-summaries-v1",
  "title": "Outcome summary public projection v1",
  "type": "object",
  "required": [
    "version",
    "method",
    "assessedOn",
    "records"
  ],
  "properties": {
    "version": {
      "const": "1.0.0"
    },
    "method": {
      "const": "selected-source-benefit-v1"
    },
    "assessedOn": {
      "type": "string",
      "format": "date"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "synthesisIds",
          "drugId",
          "conditionId",
          "label",
          "purpose",
          "grade",
          "effect",
          "evidence",
          "sourceIds",
          "aggregationNote"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "synthesisIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "drugId": {
            "type": "string"
          },
          "conditionId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "purpose": {
            "enum": [
              "prevention",
              "treatment",
              "mechanistic",
              "safety"
            ]
          },
          "grade": {
            "type": "object",
            "required": [
              "value",
              "label",
              "rationale",
              "sourceIds"
            ],
            "properties": {
              "value": {
                "enum": [
                  "A",
                  "B",
                  "C",
                  "D",
                  "E",
                  "F",
                  null
                ]
              },
              "label": {
                "type": "string"
              },
              "rationale": {
                "type": "string"
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "effect": {
            "type": "object",
            "required": [
              "label",
              "detail",
              "direction",
              "rationale"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "direction": {
                "enum": [
                  "benefit",
                  "harm",
                  "mixed",
                  "uncertain",
                  "not_applicable"
                ]
              },
              "rationale": {
                "type": "string"
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "rctCount",
              "participants",
              "participantBasis",
              "trialFamilyIds",
              "sourceIds"
            ],
            "properties": {
              "rctCount": {
                "type": "integer",
                "minimum": 0
              },
              "participants": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1
              },
              "participantBasis": {
                "type": "string"
              },
              "trialFamilyIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "sourceIds": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "aggregationNote": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
