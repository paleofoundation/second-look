{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemapRx safety row v1",
  "type": "object",
  "required": [
    "id",
    "drug",
    "category",
    "text",
    "sourceIds",
    "locator",
    "reviewStatus"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "drug": {
      "type": "string"
    },
    "category": {
      "enum": [
        "contraindication",
        "precaution",
        "interaction",
        "applicability"
      ]
    },
    "text": {
      "type": "string"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "locator": {
      "type": "string"
    },
    "reviewStatus": {
      "const": "source_checked_clinical_review_pending"
    }
  },
  "additionalProperties": false
}
