{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:remaprx:RRX-GAP-001:return",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "planSha256",
    "batchId",
    "files",
    "fileCount",
    "searchLog",
    "screeningLog",
    "gaps",
    "reviewInputs",
    "ingestPrompt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "remaprx-gap-return-v1"
    },
    "planId": {
      "const": "RRX-GAP-001-1.1"
    },
    "planSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "batchId": {
      "const": "RRX-GAP-001"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "bytes",
          "mediaType",
          "sourceId",
          "canonicalReportId",
          "role",
          "downloadUrl",
          "rightsOrAccessBasis",
          "retrievedAt",
          "gapIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "description": "Unique per delivered file/version in this receipt; never reuse across assets. Companion files may share canonicalReportId with distinct sourceIds."
          },
          "canonicalReportId": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "original_report",
              "preprint",
              "notice",
              "replacement",
              "supplement",
              "protocol",
              "registry",
              "context"
            ]
          },
          "downloadUrl": {
            "type": "string",
            "minLength": 1
          },
          "rightsOrAccessBasis": {
            "type": "string",
            "minLength": 1
          },
          "retrievedAt": {
            "type": "string",
            "minLength": 1
          },
          "gapIds": {
            "type": "array",
            "items": {
              "enum": [
                "GAP-JOURNAL-ACTIV6",
                "GAP-REVIVE-NOTICE-REPLACEMENT"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      }
    },
    "fileCount": {
      "type": "integer",
      "minimum": 0
    },
    "searchLog": {
      "const": "search-log.json"
    },
    "screeningLog": {
      "const": "screening-log.json"
    },
    "gaps": {
      "const": "gaps.json"
    },
    "reviewInputs": {
      "const": "review-inputs.jsonl"
    },
    "ingestPrompt": {
      "const": "CHATGPT-INGEST-PROMPT.txt"
    }
  }
}
