{
  "schemaVersion": "REED-CAL-04-observational-v1",
  "required": [
    "schemaVersion",
    "paper",
    "source",
    "inspection",
    "design",
    "exposures",
    "results",
    "claims",
    "reviewInputs",
    "limitations",
    "scientificAcceptance",
    "humanApproval",
    "released"
  ],
  "resultRequired": [
    "id",
    "outcome",
    "population",
    "timepoint",
    "exposureContrast",
    "estimate",
    "uncertainty",
    "adjustment",
    "denominatorBasis",
    "sourceLocators",
    "acceptedSupport",
    "grade"
  ],
  "controls": [
    "Hazardratioisnotriskratio,riskdifference,absoluteeffect orcausalbenefit",
    "Cohortpooledparticipantsnotindependenttrials",
    "Postdiagnosisaspirinnotmyelomapreventionorthromboprophylaxis",
    "Timevarying/laggedexposureandcomparatorpreserved",
    "Cancer-specific/overallmortalitykeptseparate",
