  "fixedGates": {
    "scientificAcceptance": false,
    "humanApproval": false,
    "released": false,
    "acceptedSupport": false,
    "grade": null
  },
  "reviewInventory": "rules/one-match-rule/references/research-reviews/review-questions-and-inputs.json",
  "outputs": [
    "SOURCE-CANDIDATE.json",
    "review-inputs.jsonl",
    "DOWNSTREAM-MAPPING.json",
    "VISUAL-RECEIPT.json",
    "AUDIT-MANIFEST.json",
    "VALIDATION.json",
    "HANDOFF.md"
  ]
}
