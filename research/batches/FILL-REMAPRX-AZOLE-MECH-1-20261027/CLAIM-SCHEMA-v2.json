{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "claimId",
    "drug",
    "mechanism",
    "statement",
    "sourceBindings",
    "locators",
    "model",
    "reportedFinding",
    "interpretation",
    "grade",
    "domains",
    "reviewState"
  ],
  "properties": {
    "claimId": {
      "type": "string"
    },
    "drug": {
      "type": "string"
    },
    "mechanism": {
      "enum": [
        "Hedgehog",
        "Candida_morphogenesis"
      ]
    },
    "statement": {
      "type": "string"
    },
    "sourceBindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "sha256",
          "path"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "locators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sourceId",
          "locator",
          "basis"
        ],
        "properties": {
          "sourceId": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "basis": {
            "enum": [
              "full_text",
              "abstract",
              "registry",
              "supplement"
            ]
          }
        }
      }
    },
    "model": {
      "type": "string"
    },
    "reportedFinding": {
      "type": "string"
    },
    "interpretation": {
      "type": "string"
    },
    "grade": {
      "enum": [
        "High",
        "Moderate",
        "Low",
        "not_established"
      ]
    },
    "domains": {
      "type": "object",
      "required": [
        "Study methods",
        "Directness",
        "Precision",
        "Consistency",
        "Source integrity"
      ],
      "additionalProperties": {
        "type": "object",
        "required": [
          "rationale",
          "sourceIds",
          "locator"
        ],
        "properties": {
          "rationale": {
            "type": "string",
            "minLength": 15
          },
          "sourceIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "locator": {
            "type": "string"
          }
        }
      }
    },
    "reviewState": {
      "const": "AI_assisted_draft_not_independently_or_human_approved"
    }
  },
  "title": "Azole mechanism internal source inspection claim v2"
}
