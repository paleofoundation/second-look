        "search_id": {
          "type": "string",
          "minLength": 1
        },
        "request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "database": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        },
        "filters": {
          "type": "string",
          "minLength": 1
        },
        "executed_at": {
          "type": "string",
          "minLength": 1
        },
        "cutoff": {
          "type": "string",
          "minLength": 1
        },
        "hit_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "hit_count_missing_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "exported_identifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "database_access": {
          "enum": [
            "searched",
            "unavailable",
            "partially_accessible"
          ]
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        }
