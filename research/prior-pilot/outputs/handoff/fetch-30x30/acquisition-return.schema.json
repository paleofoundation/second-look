        "completion_basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "request_id",
        "status",
        "search_ids",
        "source_ids",
        "primary_fulltexts",
        "background_sources",
        "independent_study_families",
        "family_count_reason",
        "human_primary_available",
        "preclinical_only",
        "remaining_gaps",
        "next_action",
