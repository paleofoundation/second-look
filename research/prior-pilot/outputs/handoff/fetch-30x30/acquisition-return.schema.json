      "required": [
        "search_id",
        "request_ids",
        "database",
        "query",
        "filters",
        "executed_at",
        "cutoff",
        "hit_count",
        "hit_count_missing_reason",
        "exported_identifiers",
        "database_access",
        "limitations"
      ]
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "screening_id": {
          "type": "string",
          "minLength": 1
        },
        "search_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_identity": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
