        "doi_verified": {
          "type": [
            "string",
            "null"
          ]
        },
        "doi_verification_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "pmid": {
          "type": [
            "string",
            "null"
          ]
        },
        "pmcid": {
          "type": [
            "string",
            "null"
          ]
        },
        "registry_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "identity_status": {
          "enum": [
            "verified",
            "conflict",
            "not_resolved"
          ]
        },
        "identity_notes": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "enum": [
            "PRIMARY",
            "CONTEXT"
          ]
        },
        "context_tier": {
          "enum": [
            null,
            "REVIEW",
            "TEXTBOOK",
            "OTHER"
          ]
        },
        "report_role": {
          "enum": [
            "original_report",
            "protocol",
            "supplement",
            "correction",
            "retraction_notice",
            "replacement",
            "registry",
            "review",
            "textbook",
            "official_context",
            "other"
          ]
        },
        "design": {
          "enum": [
            "human_randomized",
            "human_nonrandomized",
            "human_observational",
            "case_series",
            "case_report",
            "animal",
            "cell_ex_vivo",
            "computational",
            "not_identified",
            "not_applicable"
          ]
        },
        "directness": {
          "enum": [
            "direct",
            "indirect",
            "mixed",
            "not_checked",
            "not_applicable"
          ]
        },
        "access_state": {
          "enum": [
            "full_pdf",
            "full_html",
            "partial",
            "abstract_only",
            "metadata_only",
            "registry_only",
            "inaccessible",
            "unreadable"
          ]
        },
        "filename": {
          "type": [
            "string",
            "null"
          ]
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "retrieved_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "access_checked_at": {
          "type": "string",
          "minLength": 1
        },
        "rights_or_missing_reason": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "translated": {
          "type": "boolean"
        },
        "translation_verification": {
          "type": "string",
          "minLength": 1
        },
        "duplicate_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "version_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "related_source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "correction_check": {
          "type": "string",
          "minLength": 1
        },
        "fulltext_read": {
          "const": false
        },
        "result_extraction_status": {
          "const": "not_started"
        },
        "missing_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source_id",
        "report_id",
        "study_family_id",
        "family_identity_status",
        "request_ids",
        "drug_ids",
        "condition_ids",
        "demand_ids",
        "title",
        "authors",
        "year",
        "doi_printed",
        "doi_verified",
        "doi_verification_source",
        "pmid",
        "pmcid",
        "registry_ids",
        "identity_status",
        "identity_notes",
        "collection",
        "context_tier",
        "report_role",
        "design",
        "directness",
        "access_state",
        "filename",
        "media_type",
        "bytes",
        "sha256",
        "original_url",
        "resolved_url",
        "retrieved_at",
        "access_checked_at",
        "rights_or_missing_reason",
        "language",
        "translated",
        "translation_verification",
        "duplicate_of",
        "version_of",
        "related_source_ids",
        "correction_check",
        "fulltext_read",
        "result_extraction_status",
        "missing_reason",
        "notes"
      ]
