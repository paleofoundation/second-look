{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://second-look.local/schemas/acquisition-return-3.1.json",
  "title": "Second Look acquisition-only return 3.1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "SL-ACQUISITION-3.1"
    },
    "plan_id": {
      "const": "SL-INGEST-3.1-FETCH30"
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packet_version": {
      "const": "2.1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "synthetic": {
      "type": "boolean"
    },
    "scope_request_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "candidate_return",
        "incomplete"
      ]
    },
    "searches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search"
      }
    },
    "screening": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/screening"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      }
    },
    "reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidates_screened": {
          "type": "integer",
          "minimum": 0
        },
        "included_sources": {
          "type": "integer",
          "minimum": 0
        },
        "excluded_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "uncertain_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "files_received": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_sources": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "candidates_screened",
        "included_sources",
        "excluded_candidates",
        "duplicate_candidates",
        "uncertain_candidates",
        "files_received",
        "unavailable_sources"
      ]
    },
    "validation_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "publication_status": {
      "const": "not_authorized"
    },
    "extraction_status": {
      "const": "not_started"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "plan_sha256",
    "packet_version",
    "batch_id",
    "created_at",
    "synthetic",
    "scope_request_ids",
    "status",
    "searches",
    "screening",
    "sources",
    "coverage",
    "gaps",
    "reconciliation",
    "validation_notes",
    "publication_status",
    "extraction_status"
  ],
